{"nodes": [{"id": "external_guest_mode_section", "label": "Guest Mode Pattern (CLAUDE.md)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App is browse-first: AppNavigator always mounts public screens, only Settings is gated. Two conventions cover gating: RequireAuth wraps whole screens with no meaningful guest view; useRequireAuth's requireAuth(action) gates a single onPress action on an otherwise-public screen. Chosen because a mobile app without a login-only paywall generally wants people looking around before committing to an account."}, {"id": "claudemd_orchestration_workflow", "label": "Mobile repo orchestration workflow", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claudemd_guest_mode_doc", "label": "CLAUDE.md guest mode conventions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claudemd_orchestration_workflow", "target": "rnuidev_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claudemd_orchestration_workflow", "target": "rnstatenavdev_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claudemd_orchestration_workflow", "target": "rnreviewer_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claudemd_guest_mode_doc", "target": "requireauth_RequireAuth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file