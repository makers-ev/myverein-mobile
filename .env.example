# Base URL of the _template_better-auth-backend Hono server (see its src/index.ts,
# defaults to http://localhost:3000). EXPO_PUBLIC_* vars are inlined into the
# JS bundle at build time by Expo/Metro -- no extra app.json/app.config
# wiring is required for SDK 49+.
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Must match one of the mobile app's registered URL schemes / the backend's
# MOBILE_SCHEME (see _template_better-auth-backend/.env.example), used by
# @better-auth/expo for the OAuth/social-login browser callback deep link.
# Not needed for the native email/password flow.
EXPO_PUBLIC_AUTH_SCHEME=better-auth-mobile-template

# Public URL of _template_better-auth-website. Passed as the verification
# email's callbackURL (src/auth/auth-client.ts) so the link a user clicks
# from their mail client opens the website's /verify-email page -- there is
# deliberately no mobile deep-link callback here, see ADR/plan for why.
EXPO_PUBLIC_WEBSITE_URL=http://localhost:3001

# Public URL of an external status page (e.g. Uptime Kuma or similar) shown
# as a link on the connection-error fallback (AppNavigator/
# ConnectionErrorScreen) when the backend can't be reached. Leave unset until
# that instance exists -- the link stays hidden rather than pointing nowhere.
# Include the scheme (e.g. https://status.example.com) -- ConnectionErrorScreen
# defaults a missing one to https://, but a bare domain here is still a
# mistake worth avoiding.
EXPO_PUBLIC_STATUS_PAGE_URL=

# Public URL for reporting a bug/error (e.g. a support form, a GitHub issue
# template), shown as a second link on the same connection-error fallback,
# below the status-page link. Same "hidden until configured" logic (and
# same "include the scheme" note) as EXPO_PUBLIC_STATUS_PAGE_URL above.
EXPO_PUBLIC_ERROR_REPORT_URL=
